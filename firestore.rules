rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fieldWorksEntitlements/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /fieldWorksPurchaseOwners/{purchaseHash} {
      allow read, write: if false;
    }

    // FieldWorks feedback is written and assigned a running ID only by
    // the trusted Cloud Function using the Firebase Admin SDK.
    match /fieldWorksFeedback/{feedbackId} {
      allow read, write: if false;
    }

    match /fieldWorksCounters/{counterId} {
      allow read, write: if false;
    }

    match /fieldWorksFeedbackRequests/{requestHash} {
      allow read, write: if false;
    }

    match /fieldWorksFeedbackRateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
